{
  "functions": [
    {
      "source": "functions",
      "codebase": "beta-car",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*",
        "*adminsdk*.json",
        "service-account*.json"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "europe-west1"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.html",
      "ilanlar.html",
      "ilan.html",
      "model.html",
      "degerleme.html",
      "karsilastir.html",
      "talepler.html",
      "paketler.html",
      "firmalar.html",
      "firma.html",
      "yazilar.html",
      "sayfa.html",
      "sitemap.xml"
    ],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "/api{,/**}",
        "function": {
          "functionId": "api",
          "region": "europe-west1"
        }
      },
      {
        "source": "/",
        "function": {
          "functionId": "seo",
          "region": "europe-west1"
        }
      },
      {
        "source": "/{index.html,ilanlar.html,ilan.html,model.html,degerleme.html,karsilastir.html,talepler.html,paketler.html,firmalar.html,firma.html,yazilar.html,sayfa.html,sitemap.xml,kullanilmis,sifir,parca}",
        "function": {
          "functionId": "seo",
          "region": "europe-west1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com https://www.google.com/recaptcha/ https://www.recaptcha.net/recaptcha/; style-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; frame-src 'self' https://www.google.com https://www.recaptcha.net https://*.firebaseapp.com"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      },
      {
        "source": "/{admin,hesabim,mesajlar,giris,ilan-ver,foto}.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/api{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/404.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          }
        ]
      },
      {
        "source": "/cevrimdisi.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/{manifest.json,favicon.ico}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/icon-192.png",
        "destination": "/assets/icon-192.png",
        "type": 301
      },
      {
        "source": "/icon-512.png",
        "destination": "/assets/icon-512.png",
        "type": 301
      },
      {
        "source": "/favicon.png",
        "destination": "/assets/favicon-32.png",
        "type": 301
      },
      {
        "source": "/apple-touch-icon.png",
        "destination": "/assets/apple-touch-icon.png",
        "type": 301
      },
      {
        "source": "/logo.png",
        "destination": "/assets/logo.webp",
        "type": 301
      },
      {
        "source": "/logo-header.webp",
        "destination": "/assets/logo-white.webp",
        "type": 301
      }
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  },
  "auth": {
    "providers": {
      "anonymous": false,
      "emailPassword": true
    },
    "authorizedDomains": [
      "beta-car-a019a9b0.firebaseapp.com",
      "beta-car-a019a9b0.web.app",
      "kon-tak.vercel.app"
    ]
  }
}
