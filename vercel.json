{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -- --firebase",
  "outputDirectory": ".build",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/__/firebase/init.json",
      "destination": "https://beta-car-a019a9b0.web.app/__/firebase/init.json"
    },
    {
      "source": "/api/:path*",
      "destination": "https://beta-car-a019a9b0.web.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "https://beta-car-a019a9b0.web.app/"
    },
    {
      "source": "/ilanlar.html",
      "destination": "https://beta-car-a019a9b0.web.app/ilanlar.html"
    },
    {
      "source": "/ilan.html",
      "destination": "https://beta-car-a019a9b0.web.app/ilan.html"
    },
    {
      "source": "/model.html",
      "destination": "https://beta-car-a019a9b0.web.app/model.html"
    },
    {
      "source": "/degerleme.html",
      "destination": "https://beta-car-a019a9b0.web.app/degerleme.html"
    },
    {
      "source": "/karsilastir.html",
      "destination": "https://beta-car-a019a9b0.web.app/karsilastir.html"
    },
    {
      "source": "/talepler.html",
      "destination": "https://beta-car-a019a9b0.web.app/talepler.html"
    },
    {
      "source": "/paketler.html",
      "destination": "https://beta-car-a019a9b0.web.app/paketler.html"
    },
    {
      "source": "/firmalar.html",
      "destination": "https://beta-car-a019a9b0.web.app/firmalar.html"
    },
    {
      "source": "/firma.html",
      "destination": "https://beta-car-a019a9b0.web.app/firma.html"
    },
    {
      "source": "/yazilar.html",
      "destination": "https://beta-car-a019a9b0.web.app/yazilar.html"
    },
    {
      "source": "/sayfa.html",
      "destination": "https://beta-car-a019a9b0.web.app/sayfa.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://beta-car-a019a9b0.web.app/sitemap.xml"
    },
    {
      "source": "/kullanilmis",
      "destination": "https://beta-car-a019a9b0.web.app/kullanilmis"
    },
    {
      "source": "/sifir",
      "destination": "https://beta-car-a019a9b0.web.app/sifir"
    },
    {
      "source": "/parca",
      "destination": "https://beta-car-a019a9b0.web.app/parca"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com https://www.google.com/recaptcha/ https://www.recaptcha.net/recaptcha/; style-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; frame-src 'self' https://www.google.com https://www.recaptcha.net https://*.firebaseapp.com"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:page(admin|hesabim|mesajlar|giris|ilan-ver|foto|cevrimdisi).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/:file(manifest.json|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/icon-192.png",
      "destination": "/assets/icon-192.png",
      "permanent": true
    },
    {
      "source": "/icon-512.png",
      "destination": "/assets/icon-512.png",
      "permanent": true
    },
    {
      "source": "/favicon.png",
      "destination": "/assets/favicon-32.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/assets/apple-touch-icon.png",
      "permanent": true
    },
    {
      "source": "/logo.png",
      "destination": "/assets/logo.webp",
      "permanent": true
    },
    {
      "source": "/logo-header.webp",
      "destination": "/assets/logo-white.webp",
      "permanent": true
    }
  ]
}
